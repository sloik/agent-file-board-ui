{
  "schemaVersion": 1,
  "models": {
    "Signer": {
      "mode": "action",
      "positive": [
        "signer: successful publish and completion",
        "signer: atomic failed second binding",
        "signer: lock during import",
        "signer: lock during second proof",
        "signer: lock during signing",
        "signer: expiry during signing",
        "signer: board change before guard",
        "signer: key change before guard",
        "signer: newer draft during close",
        "signer: crypto failure"
      ],
      "mutants": [
        "signer mutant: partial unlock",
        "signer mutant: stale signature",
        "signer mutant: skipped delivery guard",
        "signer mutant: erased newer draft"
      ],
      "variables": [
        "catalog",
        "invalidations",
        "unlockEpoch",
        "unlockPc",
        "proved",
        "signEpoch",
        "signPc",
        "returned",
        "badReturn",
        "publishPc",
        "deliveryEpoch",
        "authorized",
        "badAuthorization",
        "published",
        "completed",
        "board",
        "head",
        "reviewedBoard",
        "reviewedHead",
        "draft",
        "buffer"
      ],
      "invariants": [
        "AtomicUnlock",
        "NoStaleReturn",
        "ValidAuthorization",
        "KeepNewDraft"
      ],
      "collector": "formal/collect_signer.js"
    },
    "ViewerUpdate": {
      "mode": "record",
      "positive": [
        "same-day contenders, overdue reopening and manual check",
        "opt-out preserves explicit manual check",
        "dirty and pending reloads refuse until cleared",
        "generated viewer schedule 0",
        "generated viewer schedule 1",
        "generated viewer schedule 2",
        "generated viewer schedule 3",
        "generated viewer schedule 4",
        "generated viewer schedule 5",
        "generated viewer schedule 6",
        "generated viewer schedule 7"
      ],
      "mutants": [
        "implementation mutant: duplicate daily claim",
        "implementation mutant: reload erases unfinished draft"
      ],
      "collector": "formal/collect_traces.js"
    },
    "AnswerAcceptance": {
      "mode": "record",
      "collector": "formal/collect_answers.js",
      "positive": [
        "answer: first and backdated history survive reload",
        "answer: offline fork and explicit resolution",
        "answer: concurrent resolutions and merge",
        "answer: out-of-order missing evidence",
        "answer: trust exclusion blocks promotion",
        "answer: unauthorized acceptance blocked",
        "answer: legacy history and reordered convergence",
        "answer: late offline claim reopens conflict",
        "answer: explicit legacy anchoring"
      ],
      "mutants": [
        "answer mutant: ignores offline conflict",
        "answer mutant: later history replaces first",
        "answer mutant: accepts excluded claim",
        "answer mutant: unauthorized resolution"
      ]
    },
    "ComposerSigning": {
      "mode": "record",
      "collector": "formal/collect_composer.js",
      "positive": [
        "composer: unlock persona key and post signed",
        "composer: other participant key never binds",
        "composer: switching to a locked persona blocks signed posting",
        "composer: expiry is rechecked at send",
        "composer: required destination needs approval",
        "composer: no unsigned fallback in signed mode or required room",
        "composer: read-only folder",
        "composer: unregistered persona",
        "composer: revoked key",
        "composer: rotated key needs the new key and approval",
        "composer: signing unavailable",
        "composer: every status in order",
        "composer generated schedule 0",
        "composer generated schedule 1",
        "composer generated schedule 2",
        "composer generated schedule 3",
        "composer generated schedule 4",
        "composer generated schedule 5",
        "composer generated schedule 6",
        "composer generated schedule 7"
      ],
      "mutants": [
        "composer mutant: another unlocked key makes the persona ready",
        "composer mutant: signed mode falls back to unsigned",
        "composer mutant: required destination skips approval",
        "composer mutant: revoked key is ignored"
      ]
    }
  }
}
