{
  "name": "agent-file-board-ui",
  "version": "3.3.10",
  "description": "Browser UI (viewer and composer) for the agent-file-board standard",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "python3 formal/check_alignment.py && python3 scripts/build_update_checker.py --check && node scripts/embed_rich.js --check && node scripts/embed_openui.js --check && node scripts/embed_upgrade.js --check && node scripts/embed_forms.js --check && node scripts/embed_tools.js --check && node scripts/embed_signing.js --check && node scripts/embed_history.js --check && node scripts/build_signing_diagrams.js --check && node --test tests/*.test.js && python3 -m unittest discover -s tests -p \"test_*.py\"",
    "test:node": "node --test tests/*.test.js",
    "release-check": "python3 scripts/release_check.py",
    "embed:rich": "node scripts/embed_rich.js",
    "screenshots": "node scripts/screenshots.js",
    "embed:openui": "node scripts/embed_openui.js",
    "screenshots:openui": "node scripts/screenshot_openui.js",
    "embed:upgrade": "node scripts/embed_upgrade.js",
    "screenshots:upgrade": "node scripts/screenshot_upgrade.js",
    "screenshots:static": "node scripts/screenshot_static_openui.js",
    "screenshots:candidates": "node scripts/screenshot_static_candidates.js",
    "demo": "python3 scripts/build_demo.py --output agent-file-board-demo.zip",
    "screenshots:demo": "node scripts/screenshot_demo.js",
    "embed:forms": "node scripts/embed_forms.js",
    "screenshots:forms": "node scripts/screenshot_forms.js",
    "screenshots:workflows": "node scripts/screenshot_workflows.js",
    "embed:tools": "node scripts/embed_tools.js",
    "screenshots:tools": "node scripts/screenshot_tools.js",
    "screenshots:locations": "node scripts/screenshot_locations.js",
    "screenshots:themes": "node scripts/screenshot_themes.js",
    "screenshots:panels": "node scripts/screenshot_panels.js",
    "screenshots:toolbar": "node scripts/screenshot_toolbar.js",
    "screenshots:features": "node scripts/screenshot_features.js",
    "screenshots:all": "node scripts/screenshots_all.js",
    "embed:signing": "node scripts/embed_signing.js",
    "embed:history": "node scripts/embed_history.js",
    "diagrams:signing": "node scripts/build_signing_diagrams.js"
  },
  "devDependencies": {
    "@noble/curves": "2.4.0",
    "@openuidev/react-lang": "1.0.1",
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "marked": "18.1.1",
    "playwright": "1.62.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.3.6"
  }
}
